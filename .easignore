# Ignore node_modules (but NOT local native modules that we need)
node_modules/@*
node_modules/[a-q]*
node_modules/[s-z]*
node_modules/react-[a-m]*
node_modules/react-[o-z]*

# Ignore build outputs and cache
.expo/**
dist/**
android/app/build/**
android/.gradle/**
android/build/**

# Ignore cache and temp files
.cache/**
tmp/**
temp/**

# Ignore local native module build outputs but KEEP source code
react-native-yara-engine/android/build/**
react-native-yara-engine/android/.cxx/**
react-native-proxy-engine/android/build/**
react-native-proxy-engine/android/.cxx/**

# Ignore local files
*.log
.DS_Store
.env.local

# Ignore patches that may have complex patterns
patches/**
